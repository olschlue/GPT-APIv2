# OpenAI API Key (geheim – .env niemals committen!)
OPENAI_API_KEY=sk-...

# Modelle (Defaults laut Vorgabe)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_ANALYSIS_MODEL=gpt-5-mini

# Maximale Upload-Größe in MB
MAX_UPLOAD_MB=200

# Optional: abweichender API-Endpunkt (z. B. Proxy / Azure-kompatibel)
# OPENAI_BASE_URL=https://api.openai.com/v1
